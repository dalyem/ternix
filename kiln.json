{
  "version": 1,
  "projectId": "prj_o5mxzwjppxwv",
  "name": "ternix",
  "runtime": {
    "image": "node:22-bookworm-slim"
  },
  "install": "corepack pnpm install --frozen-lockfile --ignore-scripts",
  "dev": "corepack pnpm --filter @ternix/server dev",
  "port": 8080,
  "env": {
    "TERNIX_DATA_DIR": "/tmp/ternix-dev-data"
  },
  "health": {
    "path": "/api/v1/server"
  },
  "checks": {
    "lint": "corepack pnpm run lint",
    "typecheck": "corepack pnpm run typecheck",
    "test": "corepack pnpm run test"
  }
}
